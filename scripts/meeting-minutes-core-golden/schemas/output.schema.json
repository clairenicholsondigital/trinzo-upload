{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalised minutes output",
  "type": "object",
  "required": [
    "meeting_type",
    "attendees",
    "client_attendees",
    "actions",
    "decisions",
    "risks"
  ],
  "properties": {
    "meeting_type": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "owner",
          "action"
        ],
        "properties": {
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "due_evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
